# Copie este arquivo para ".env" e ajuste os valores.
# Nunca versione o arquivo ".env" nem credenciais reais.

# ---------- SQL Server ----------
# A senha deve atender a politica de complexidade do SQL Server
# (minimo de 8 caracteres, com maiusculas, minusculas, numeros e simbolos).
MSSQL_SA_PASSWORD=ChangeMe_Str0ng!Pass
MSSQL_PID=Developer
ACCEPT_EULA=Y
MSSQL_PORT=1433
DB_NAME=MiniGestaoPedidos

# ---------- API ----------
API_PORT=5000
ASPNETCORE_ENVIRONMENT=Development
# Exemplo de connection string (dentro do Docker Compose o host e o servico "sqlserver").
ConnectionStrings__DefaultConnection=Server=sqlserver,1433;Database=MiniGestaoPedidos;User Id=sa;Password=ChangeMe_Str0ng!Pass;TrustServerCertificate=True

# ---------- Frontend ----------
FRONTEND_PORT=3000
# URL da API vista pelo navegador.
VITE_API_URL=http://localhost:5000
