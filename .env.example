# Copie este arquivo para ".env" e ajuste os valores.
# Nunca versione o arquivo ".env" nem credenciais reais.

# ---------- SQL Server ----------
# A senha deve atender a politica de complexidade do SQL Server
# (minimo de 8 caracteres, com maiusculas, minusculas, numeros e simbolos).
# Evite ";" e "=" na senha: quebram a connection string montada no Compose.
MSSQL_SA_PASSWORD=ChangeMe_Str0ng!Pass
MSSQL_PID=Developer
ACCEPT_EULA=Y
# Porta publicada só em 127.0.0.1 (ferramentas locais / MCP / sqlcmd).
MSSQL_PORT=1433

# ---------- API ----------
API_PORT=5000
ASPNETCORE_ENVIRONMENT=Development
# Usada apenas ao rodar a API fora do Docker (dotnet run, E2E com webServer).
# Dentro do Compose a connection string e montada automaticamente com host "sqlserver".
ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=MiniGestaoPedidos;User Id=sa;Password=ChangeMe_Str0ng!Pass;TrustServerCertificate=True

# ---------- Frontend ----------
FRONTEND_PORT=3000
# URL da API vista pelo navegador (embutida no build Vite).
# Se omitida, o Compose usa http://localhost:${API_PORT}.
# Mudar API_PORT ou VITE_API_URL exige rebuild: docker compose up -d --build frontend
# VITE_API_URL=http://localhost:5000
