# Copie para ".env.mcp" (arquivo ignorado pelo Git) e preencha a senha.
# Usado por .cursor/mcp.json (envFile) para o MCP SQL Server somente leitura.
# Use SEMPRE o usuario somente leitura (database/optional/create-readonly-user.sql), nunca o "sa".

SERVER_NAME=localhost
SQL_PORT=1433
DATABASE_NAME=MiniGestaoPedidos
SQL_USER=mcp_readonly
SQL_PASSWORD=<defina-uma-senha-forte-igual-a-usada-no-script>
TRUST_SERVER_CERTIFICATE=true
